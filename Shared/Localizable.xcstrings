    "Daily nudge at %@ if a tracked streak isn't locked in yet. iOS will ask for notification permission the first time you turn this on." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täglicher Hinweis um %@, wenn eine verfolgte Serie noch nicht gesichert ist. iOS fragt beim ersten Einschalten nach der Erlaubnis für Mitteilungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso diario a las %@ si una racha seguida aún no está asegurada. iOS te pedirá permiso para notificaciones la primera vez que lo actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappel quotidien à %@ si une série suivie n'est pas encore validée. iOS demandera l'autorisation des notifications la première fois que vous l'activez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria giornaliero alle %@ se una serie seguita non è ancora completata. iOS chiederà il permesso per le notifiche la prima volta che lo attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追跡中の記録がまだ達成されていない場合、毎日%@にお知らせします。初めてオンにすると、iOSが通知の許可を求めます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagelijkse herinnering om %@ als een gevolgde reeks nog niet binnen is. iOS vraagt de eerste keer dat je dit aanzet om toestemming voor meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codzienne przypomnienie o %@, jeśli śledzona seria nie jest jeszcze zaliczona. Przy pierwszym włączeniu iOS poprosi o zgodę na powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso diário às %@ se uma sequência acompanhada ainda não estiver garantida. O iOS vai pedir permissão para notificações na primeira vez que você ativar."
          }
        }
      }
    },
