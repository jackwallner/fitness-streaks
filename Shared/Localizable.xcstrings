    "We didn't find any active streaks in your Apple Health history. Once you log a few days of activity, we'll surface them here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Apple Health Verlauf haben wir keine aktiven Streaks gefunden. Sobald du ein paar Tage Aktivität erfasst hast, zeigen wir sie dir hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We didn't find any active streaks in your Apple Health history. Once you log a few days of activity, we'll surface them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos rachas activas en tu historial de Apple Health. Cuando registres unos días de actividad, aparecerán aquí."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben geen actieve reeksen gevonden in je Apple Health-geschiedenis. Zodra je een paar dagen activiteit hebt vastgelegd, laten we ze hier zien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В истории Apple Health нет активных серий. Как только наберётся несколько дней активности, они появятся здесь."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi chưa tìm thấy chuỗi nào đang duy trì trong lịch sử Apple Health của bạn. Khi bạn ghi lại vài ngày hoạt động, các chuỗi sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Apple Health 历史记录中没有找到进行中的连续记录。记录几天活动后，它们就会出现在这里。"
          }
        }
      }
    },
    "Weekly streaks reset on Mondays, ISO-style.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Wochen-Streaks beginnt die Woche nach ISO am Montag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly streaks reset on Mondays, ISO-style."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rachas semanales se reinician los lunes (semana ISO)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuwe week voor je reeks begint op maandag (ISO-weken)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недельные серии обнуляются по понедельникам, по стандарту ISO."
