    "Would you like to recalibrate your goals based on this new lookback period? This will re-analyze your last %lld days and may suggest different goals." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du deine Ziele für den neuen Zeitraum neu kalibrieren? Dabei werden deine letzten %lld Tage neu analysiert, eventuell mit anderen Zielvorschlägen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres recalibrar tus objetivos según este nuevo periodo? Se volverán a analizar tus últimos %lld días y puede que se sugieran otros objetivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous recalibrer vos objectifs selon cette nouvelle période ? Vos %lld derniers jours seront réanalysés et d'autres objectifs pourront être suggérés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi ricalibrare i tuoi obiettivi in base a questo nuovo periodo? Gli ultimi %lld giorni verranno rianalizzati e potrebbero essere suggeriti obiettivi diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい期間に合わせて目標を再調整しますか？直近%lld日間を再分析し、別の目標を提案する場合があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je je doelen herkalibreren op basis van deze nieuwe periode? Je laatste %lld dagen worden opnieuw geanalyseerd, mogelijk met andere doelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy skalibrować cele ponownie dla nowego okresu? Przeanalizujemy ponownie Twoje ostatnie %#@n@ i możemy zaproponować inne cele."
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg dzień"
                    }
                  },
                  "few" : {
                    "stringUnit" : {
