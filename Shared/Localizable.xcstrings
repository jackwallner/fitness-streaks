    "Could not request Health access from iOS. If the prompt does not appear, open Health or Settings and enable access for Streaks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Health-Zugriff konnte nicht von iOS angefragt werden. Wenn die Abfrage nicht erscheint, öffne Health oder die Einstellungen und erlaube den Zugriff für Streaks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not request Health access from iOS. If the prompt does not appear, open Health or Settings and enable access for Streaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo solicitar acceso a Health desde iOS. Si no aparece el aviso, abre Health o Ajustes y activa el acceso para Streaks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-toegang aanvragen bij iOS is niet gelukt. Als het verzoek niet verschijnt, open je Health of Instellingen en schakel je toegang in voor Streaks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запросить доступ к Health в iOS. Если запрос не появился, открой Health или «Настройки» и включи доступ для Streaks."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể yêu cầu quyền truy cập Health từ iOS. Nếu lời nhắc không hiện, hãy mở Health hoặc Cài đặt và bật quyền truy cập cho Streaks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法向 iOS 请求 Health 访问权限。如果没有弹出提示，请打开 Health 或“设置”，为 Streaks 开启访问权限。"
          }
        }
      }
    },
