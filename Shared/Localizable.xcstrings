        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存するには%lld件の選択を外すか、無料トライアルですべて残しましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
