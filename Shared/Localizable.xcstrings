    "Miss a day later on? Streaks+ revives the run instead of zeroing it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Später einen Tag verpasst? Streaks+ rettet die Serie, statt sie auf null zu setzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Fallas un día más adelante? Streaks+ rescata la racha en vez de dejarla en cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour manqué plus tard ? Streaks+ sauve la série au lieu de la remettre à zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salti un giorno più avanti? Streaks+ salva la serie invece di azzerarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで1日逃しても、Streaks+がゼロに戻さず記録を復活させます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later een dag gemist? Streaks+ redt de reeks in plaats van hem op nul te zetten."
