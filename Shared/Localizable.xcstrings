    "Would you like to recalibrate your goals based on this new lookback period? This will re-analyze your last %lld days and may suggest different goals.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Möchtest du deine Ziele anhand dieses neuen Zeitraums neu kalibrieren? Dabei wird der letzte Zeitraum von %lld Tag neu analysiert und es werden eventuell andere Ziele vorgeschlagen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Möchtest du deine Ziele anhand dieses neuen Zeitraums neu kalibrieren? Dabei werden deine letzten %lld Tage neu analysiert und es werden eventuell andere Ziele vorgeschlagen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Would you like to recalibrate your goals based on this new lookback period? This will re-analyze your last %lld day and may suggest different goals."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Would you like to recalibrate your goals based on this new lookback period? This will re-analyze your last %lld days and may suggest different goals."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Quieres recalibrar tus objetivos según este nuevo periodo de análisis? Se volverán a analizar tus últimos %lld días y puede que te sugiramos objetivos distintos."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Quieres recalibrar tus objetivos según este nuevo periodo de análisis? Se volverá a analizar tu último %lld día y puede que te sugiramos objetivos distintos."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Quieres recalibrar tus objetivos según este nuevo periodo de análisis? Se volverán a analizar tus últimos %lld días y puede que te sugiramos objetivos distintos."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wil je je doelen opnieuw afstemmen op deze nieuwe terugkijkperiode? Dan analyseren we je laatste %lld dag opnieuw en stellen we mogelijk andere doelen voor."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wil je je doelen opnieuw afstemmen op deze nieuwe terugkijkperiode? Dan analyseren we je laatste %lld dagen opnieuw en stellen we mogelijk andere doelen voor."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Хочешь пересчитать цели с учётом нового периода анализа? Мы заново проанализируем данные за последние %lld дня и можем предложить другие цели."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Хочешь пересчитать цели с учётом нового периода анализа? Мы заново проанализируем данные за последние %lld дней и можем предложить другие цели."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Хочешь пересчитать цели с учётом нового периода анализа? Мы заново проанализируем данные за последний %lld день и можем предложить другие цели."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Хочешь пересчитать цели с учётом нового периода анализа? Мы заново проанализируем данные за последние %lld дня и можем предложить другие цели."
                }
              }
            }
          }
        },
        "vi": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Bạn có muốn hiệu chỉnh lại mục tiêu dựa trên khoảng thời gian xem lại mới này không? Thao tác này sẽ phân tích lại %lld ngày gần nhất của bạn và có thể đề xuất các mục tiêu khác."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "要根据新的回溯期重新校准你的目标吗？这会重新分析你最近 %lld 天的数据，并可能给出不同的目标。"
                }
              }
            }
          }
        }
      }
    },
    "YEARLY": {
      "extractionState": "manual",
      "localizations": {
        "de": {
