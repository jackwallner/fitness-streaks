    "Tap any locked streak to see Streaks+ plans and add it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen gesperrten Streak, um die Streaks+ Abos zu sehen und ihn hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any locked streak to see Streaks+ plans and add it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier racha bloqueada para ver los planes de Streaks+ y añadirla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een vergrendelde reeks om de Streaks+-abonnementen te bekijken en de reeks toe te voegen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на любую заблокированную серию, чтобы увидеть планы Streaks+ и добавить её."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào chuỗi bị khóa bất kỳ để xem các gói Streaks+ và thêm chuỗi đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按任意已锁定的连续记录，查看 Streaks+ 方案并添加。"
          }
        }
      }
    },
    "Tap any locked streak to start a free trial and add it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen gesperrten Streak, um die kostenlose Testphase zu starten und ihn hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any locked streak to start a free trial and add it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier racha bloqueada para empezar una prueba gratis y añadirla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een vergrendelde reeks om een gratis proefperiode te starten en de reeks toe te voegen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на любую заблокированную серию, чтобы начать бесплатный пробный период и добавить её."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào chuỗi bị khóa bất kỳ để dùng thử miễn phí và thêm chuỗi đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按任意已锁定的连续记录，开始免费试用并添加。"
          }
        }
      }
    },
