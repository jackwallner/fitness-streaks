    "Days you mark won't break or extend a streak." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markierte Tage brechen keine Serie und verlängern sie nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días que marques no rompen ni alargan una racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours marqués ne cassent ni n'allongent une série."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni segnati non interrompono né allungano una serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録した日は記録を途切れさせず、延ばしもしません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemarkeerde dagen breken of verlengen geen reeks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznaczone dni nie przerywają ani nie wydłużają serii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias marcados não quebram nem aumentam uma sequência."
          }
        }
      }
    },
    "Define your own threshold, cadence, and hour window, beyond the discovered set." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege eigene Ziele, Rhythmen und Zeitfenster fest, über die gefundenen Serien hinaus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define tu propio objetivo, frecuencia y franja horaria, más allá de las rachas encontradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez vos propres objectif, rythme et créneau horaire, au-delà des séries trouvées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli obiettivo, cadenza e fascia oraria, oltre alle serie trovate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見つかった記録以外にも、目標、頻度、時間帯を自分で設定できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel je eigen doel, ritme en tijdvak in, naast de gevonden reeksen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustal własny cel, rytm i przedział godzin, poza znalezionymi seriami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina sua própria meta, frequência e faixa de horário, além das sequências encontradas."
          }
        }
      }
    },
    "Deselect %lld to save, or start a free trial to keep them all." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle %lld ab, um zu speichern, oder teste gratis, um alle zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita %lld para guardar o empieza una prueba gratis para conservarlas todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désélectionnez-en %lld pour enregistrer, ou lancez un essai gratuit pour toutes les garder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseleziona %lld per salvare, o avvia una prova gratuita per tenerle tutte."
