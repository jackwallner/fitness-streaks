    "Could not request Health access from iOS. If the prompt does not appear, open Health or Settings and enable access for Streaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health-Zugriff konnte nicht bei iOS angefragt werden. Falls keine Abfrage erscheint, öffne Health oder die Einstellungen und erlaube Streaks den Zugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo solicitar acceso a Salud. Si no aparece el aviso, abre Salud o Ajustes y permite el acceso a Streaks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de demander l'accès à Santé. Si la demande n'apparaît pas, ouvrez Santé ou Réglages et autorisez Streaks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile richiedere l'accesso a Salute. Se la richiesta non compare, apri Salute o Impostazioni e consenti l'accesso a Streaks."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアへのアクセスをリクエストできませんでした。確認画面が表示されない場合は、ヘルスケアまたは設定を開いてStreaksへのアクセスを許可してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan geen toegang tot Gezondheid aanvragen. Zie je geen melding, open dan Gezondheid of Instellingen en geef Streaks toegang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się poprosić o dostęp do Zdrowia. Jeśli prośba się nie pojawi, otwórz Zdrowie lub Ustawienia i zezwól na dostęp dla Streaks."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível solicitar acesso ao Saúde. Se o aviso não aparecer, abra o Saúde ou Ajustes e permita o acesso do Streaks."
          }
        }
      }
    },
    "Could not request Health access from iOS. Open Settings and enable Health access for Streaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
