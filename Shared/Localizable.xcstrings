                      "value": "последний %arg день"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "последние %arg дня"
                    }
                  }
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này phân tích lại hoạt động trong %#@n@ gần nhất và có thể gợi ý mục tiêu khác với %2$@ hiện tại của bạn. Nếu mục tiêu mới cao hơn hoạt động gần đây, chuỗi của bạn có thể bị đứt."
          },
          "substitutions": {
