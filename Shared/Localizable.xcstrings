    "Planned freezes let you mark vacation, travel, or sick days so they don't break your streaks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit geplanten Pausen markierst du Urlaubs-, Reise- oder Krankheitstage, damit sie deine Streaks nicht unterbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned freezes let you mark vacation, travel, or sick days so they don't break your streaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pausas planificadas te permiten marcar días de vacaciones, viaje o enfermedad para que no rompan tus rachas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met geplande pauzes markeer je vakantie-, reis- of ziektedagen, zodat ze je reeksen niet breken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плановые заморозки позволяют отметить отпуск, поездки или дни болезни, чтобы они не прерывали серии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng băng theo kế hoạch cho phép bạn đánh dấu ngày nghỉ lễ, đi xa hoặc ốm để không làm đứt chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划冻结可让你标记度假、出行或生病的日子，这样它们就不会中断你的连续记录。"
          }
        }
      }
    },
