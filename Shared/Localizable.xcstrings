    "Are you sure? This will update your goal based on recent activity. If the new goal is higher, you might lose your streak." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher? Dein Ziel wird anhand deiner letzten Aktivität angepasst. Ist das neue Ziel höher, kann deine Serie reißen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro? Tu objetivo se actualizará según tu actividad reciente. Si el nuevo objetivo es más alto, podrías perder tu racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes sûr ? Votre objectif sera mis à jour selon votre activité récente. S'il est plus élevé, vous pourriez perdre votre série."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro? L'obiettivo verrà aggiornato in base alla tua attività recente. Se il nuovo obiettivo è più alto, potresti perdere la serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしいですか？最近のアクティビティに基づいて目標が更新されます。新しい目標が高い場合、記録が途切れることがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je het zeker? Je doel wordt bijgewerkt op basis van je recente activiteit. Is het nieuwe doel hoger, dan kun je je reeks verliezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pewno? Cel zostanie zaktualizowany na podstawie ostatniej aktywności. Jeśli nowy cel będzie wyższy, możesz stracić serię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza? Sua meta será atualizada com base na atividade recente. Se a nova meta for mais alta, você pode perder sua sequência."
          }
        }
      }
    },
