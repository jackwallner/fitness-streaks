    "Every other streak we found, ranked by your intensity setting. Tap any badge for history, threshold, and recent days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen gefundenen Streaks, sortiert nach deiner Intensitätseinstellung. Tippe auf ein Badge für Verlauf, Schwellenwert und letzte Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every other streak we found, ranked by your intensity setting. Tap any badge for history, threshold, and recent days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las demás rachas que encontramos, ordenadas según tu ajuste de intensidad. Toca cualquier insignia para ver historial, umbral y días recientes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle andere reeksen die we vonden, gerangschikt op je intensiteitsinstelling. Tik op een badge voor geschiedenis, drempel en recente dagen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все остальные найденные серии, отсортированные по выбранной интенсивности. Нажми на значок, чтобы увидеть историю, цель и последние дни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi chuỗi khác chúng tôi tìm thấy, xếp theo mức độ bạn chọn. Chạm vào huy hiệu để xem lịch sử, ngưỡng và những ngày gần đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们发现的其他连续记录，按你的强度设置排序。点按任一徽章查看历史、门槛和近期记录。"
          }
        }
      }
    },
