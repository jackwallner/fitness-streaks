                      "value": "%arg dagen"
                    }
                  }
                }
              }
            }
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это заново проанализирует твою активность за %#@n@ и может предложить цель, отличную от текущей (%2$@). Если новая цель выше твоей недавней активности, серия может прерваться."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
