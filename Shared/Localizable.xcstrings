        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis houd je er %lld. Abonneer je op Streaks+ om de andere %lld te houden en elke reeks te beschermen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии останется %lld. Оформи Streaks+, чтобы сохранить остальные %lld и защитить каждую серию."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói miễn phí giữ %lld chuỗi. Đăng ký Streaks+ để giữ %lld chuỗi còn lại và bảo vệ mọi chuỗi."
          }
        },
