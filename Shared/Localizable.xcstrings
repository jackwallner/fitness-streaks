    "Every other streak we found, ranked by your intensity setting. Tap any badge for history, threshold, and recent days." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anderen gefundenen Serien, sortiert nach deiner Intensität. Tippe auf ein Abzeichen für Verlauf, Ziel und letzte Tage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resto de rachas que encontramos, ordenadas según tu intensidad. Toca una insignia para ver historial, objetivo y días recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les autres séries trouvées, classées selon votre intensité. Touchez un badge pour l'historique, l'objectif et les derniers jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le altre serie trovate, ordinate per intensità. Tocca un badge per cronologia, obiettivo e ultimi giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見つかったほかの連続記録を、強度設定の順に並べています。バッジをタップすると履歴、目標、最近の日々を確認できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle andere gevonden reeksen, gesorteerd op je intensiteit. Tik op een badge voor geschiedenis, doel en recente dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostałe znalezione serie, ułożone według intensywności. Dotknij odznaki, by zobaczyć historię, cel i ostatnie dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as outras sequências encontradas, ordenadas pela sua intensidade. Toque em um selo para ver histórico, meta e dias recentes."
          }
        }
      }
    },
