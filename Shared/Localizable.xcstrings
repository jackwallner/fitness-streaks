    "Planned freezes let you mark vacation, travel, or sick days so they don't break your streaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit geplanten Pausen markierst du Urlaub, Reisen oder Krankheitstage, damit sie deine Serien nicht brechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pausas programadas te permiten marcar vacaciones, viajes o días de enfermedad para que no rompan tus rachas."
