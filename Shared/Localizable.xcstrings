    "Subscribe to Streaks+ and we'll restore your %lld-day %@ run on the spot. Streaks+ auto-saves every missed day so this doesn't happen again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
