    "We didn't find any active streaks in your Apple Health history. Once you log a few days of activity, we'll surface them here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben in deinem Apple Health-Verlauf keine aktiven Serien gefunden. Sobald du ein paar Tage Aktivität aufgezeichnet hast, erscheinen sie hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos rachas activas en tu historial de Salud. Cuando registres unos días de actividad, aparecerán aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune série active trouvée dans votre historique Santé. Après quelques jours d'activité enregistrée, elles apparaîtront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo trovato serie attive nella cronologia di Salute. Dopo qualche giorno di attività registrata, le vedrai qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアの履歴に継続中の記録は見つかりませんでした。数日分のアクティビティが記録されると、ここに表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We vonden geen actieve reeksen in je Gezondheid-geschiedenis. Zodra je een paar dagen activiteit hebt vastgelegd, verschijnen ze hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleźliśmy aktywnych serii w Twojej historii w Zdrowiu. Gdy zapiszesz kilka dni aktywności, pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encontramos sequências ativas no seu histórico do Saúde. Depois de registrar alguns dias de atividade, elas vão aparecer aqui."
          }
        }
      }
    },
