        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metas que você já bate quase todo dia. Transforme-as em sequências sem interrupção."
          }
        }
      }
    },
    "Goals you hit about half the time. Building the daily habit changes everything." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
