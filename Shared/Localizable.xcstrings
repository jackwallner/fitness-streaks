    "Streaks spotted a hidden pattern: you consistently hit this target within a single hour of the day. Keep it alive. The next window starts at %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks hat ein verstecktes Muster entdeckt: Du erreichst dieses Ziel regelmäßig innerhalb einer bestimmten Stunde. Bleib dran. Das nächste Zeitfenster beginnt um %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks detectó un patrón oculto: alcanzas este objetivo una y otra vez dentro de la misma hora del día. Mantenlo. La próxima franja empieza a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks a repéré une habitude cachée : vous atteignez cet objectif régulièrement dans la même heure de la journée. Continuez. Le prochain créneau commence à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks ha notato uno schema nascosto: raggiungi questo obiettivo con costanza sempre nella stessa ora del giorno. Continua così. La prossima fascia inizia alle %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaksが隠れたパターンを見つけました。あなたはいつも1日のうち同じ1時間の中でこの目標を達成しています。この調子で続けましょう。次の時間帯は%@に始まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks ontdekte een verborgen patroon: je haalt dit doel steeds binnen hetzelfde uur van de dag. Houd het vol. Het volgende tijdvak begint om %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks wykrył ukryty wzorzec: regularnie osiągasz ten cel w tej samej godzinie dnia. Tak trzymaj. Następne okno zaczyna się o %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Streaks encontrou um padrão escondido: você bate esta meta sempre dentro da mesma hora do dia. Continue assim. A próxima faixa começa às %@."
          }
        }
      }
    },
    "Streaks update automatically from Apple Health. No manual logging." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serien aktualisieren sich automatisch aus Apple Health. Kein manuelles Eintragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rachas se actualizan solas desde Salud. Sin registros manuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séries se mettent à jour toutes seules depuis Santé. Aucune saisie manuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serie si aggiornano da sole da Salute. Niente inserimenti manuali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連続記録はヘルスケアから自動で更新されます。手入力は不要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reeksen worden automatisch bijgewerkt uit Gezondheid. Niets handmatig invullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serie aktualizują się automatycznie ze Zdrowia. Bez ręcznego wpisywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sequências se atualizam sozinhas pelo Saúde. Sem registro manual."
          }
        }
      }
    },
    "Streaks+ auto-saves any day you miss. Your streak survives and the count keeps climbing tomorrow. Unlimited, automatic, no action needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks+ rettet jeden verpassten Tag. Deine Serie bleibt bestehen und der Zähler steigt morgen weiter. Unbegrenzt, automatisch, ohne dein Zutun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks+ rescata cualquier día que pierdas. Tu racha sobrevive y el contador sigue subiendo mañana. Ilimitado, automático, sin que hagas nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks+ sauve chaque jour manqué. Votre série survit et le compteur continue de grimper demain. Illimité, automatique, sans rien faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks+ salva ogni giorno saltato. La tua serie sopravvive e domani il conteggio continua a salire. Illimitato, automatico, senza fare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks+は逃した日をすべてセーブします。記録は途切れず、明日もカウントが増え続けます。無制限、自動、操作は不要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks+ redt elke gemiste dag. Je reeks blijft bestaan en telt morgen gewoon verder. Onbeperkt, automatisch, zonder dat je iets hoeft te doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks+ ratuje każdy opuszczony dzień. Twoja seria przetrwa, a licznik jutro dalej rośnie. Bez limitu, automatycznie, bez Twojego udziału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Streaks+ resgata qualquer dia que você perder. Sua sequência sobrevive e a contagem continua subindo amanhã. Ilimitado, automático, sem você fazer nada."
          }
        }
      }
