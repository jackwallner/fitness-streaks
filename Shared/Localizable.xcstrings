    "Change intensity, schedule planned freezes for travel or sick days, set a daily reminder, or replay this tour from About." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere die Intensität, plane Pausen für Reisen oder Krankheit, stelle eine tägliche Erinnerung ein oder starte diese Tour erneut unter „Info“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la intensidad, programa pausas por viajes o enfermedad, pon un recordatorio diario o repite este recorrido desde Acerca de."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez l'intensité, planifiez des pauses pour un voyage ou une maladie, réglez un rappel quotidien ou relancez ce tutoriel depuis À propos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia intensità, pianifica pause per viaggi o malattia, imposta un promemoria giornaliero o rivedi questo tour da Info."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強度の変更、旅行や体調不良に備えたお休み日の予約、毎日のリマインダー設定、このツアーの再表示は「情報」から行えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig de intensiteit, plan pauzes voor reizen of ziekte, stel een dagelijkse herinnering in of bekijk deze rondleiding opnieuw via Info."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień intensywność, zaplanuj przerwy na wyjazd lub chorobę, ustaw codzienne przypomnienie albo powtórz ten przewodnik w sekcji Informacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude a intensidade, programe pausas para viagens ou doença, defina um lembrete diário ou reveja este tour em Sobre."
          }
        }
      }
    },
