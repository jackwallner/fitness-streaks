        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo día sin cumplir la pone a cero. Streaks+ protege la racha automáticamente y hace seguimiento de cada racha que consigues, gratis con tu %#@n@."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
