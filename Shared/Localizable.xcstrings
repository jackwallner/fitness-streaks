    "Goals you already hit most days. Turn them into unbroken streaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele, die du an den meisten Tagen schaffst. Mach daraus ununterbrochene Serien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetivos que ya cumples casi todos los días. Conviértelos en rachas sin cortes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
