                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会重新分析你最近 %#@n@的活动，可能给出与当前 %2$@ 不同的目标。如果新目标高于你近期的活动量，连续记录可能会中断。"
          },
          "substitutions": {
            "n": {
