    "Days you mark won't break or extend a streak.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage, die du markierst, unterbrechen oder verlängern einen Streak nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days you mark won't break or extend a streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días que marques no rompen ni alargan una racha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen die je markeert, breken of verlengen een reeks niet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмеченные дни не прерывают и не продлевают серию."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ngày bạn đánh dấu sẽ không làm đứt hay kéo dài chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你标记的日子不会中断或延长连续记录。"
          }
        }
      }
    },
    "Define your own threshold, cadence, and hour window, beyond the discovered set.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eigene Schwellenwerte, Rhythmen und Zeitfenster fest, über die gefundenen Streaks hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Define your own threshold, cadence, and hour window, beyond the discovered set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define tu propio umbral, frecuencia y franja horaria, más allá de las rachas detectadas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal je eigen drempel, frequentie en tijdvenster, naast de ontdekte reeksen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создай свою серию с нужной целью, периодичностью и временем, помимо найденных серий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự đặt ngưỡng, tần suất và khung giờ, ngoài các chuỗi đã tìm thấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已发现的项目之外，自定义门槛、频率和时间段。"
          }
        }
      }
    },
    "Deselect %lld to save, or start a free trial to keep them all.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle %lld ab, um zu speichern, oder starte eine kostenlose Testphase, um alle zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect %lld to save, or start a free trial to keep them all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca %lld para guardar o empieza una prueba gratis para conservarlas todas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselecteer er %lld om op te slaan of start een gratis proefperiode om ze allemaal te houden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убери лишние серии: %lld. Затем сохрани выбор или начни бесплатный пробный период, чтобы оставить все."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ chọn bớt %lld để lưu, hoặc bắt đầu dùng thử miễn phí để giữ tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消选择 %lld 条以保存，或开始免费试用以全部保留。"
          }
        }
      }
    },
