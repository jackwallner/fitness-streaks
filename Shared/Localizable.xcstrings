    "Free caps you at %lld. Streaks+ tracks every metric you've earned, including future picks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos kannst du bis zu %lld verfolgen. Streaks+ erfasst alle Messwerte, die du dir erarbeitet hast, auch deine künftige Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free caps you at %lld. Streaks+ tracks every metric you've earned, including future picks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratis te limita a %lld. Streaks+ sigue cada métrica que has logrado, incluidas las que elijas más adelante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis kun je %lld reeksen bijhouden. Met Streaks+ volg je alle behaalde metingen, ook toekomstige keuzes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии можно отслеживать не больше %lld показателей. Streaks+ отслеживает все доступные показатели, включая будущие."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói miễn phí giới hạn bạn ở %lld. Streaks+ theo dõi mọi chỉ số bạn đạt được, kể cả những chỉ số bạn chọn sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版最多 %lld 条。Streaks+ 会追踪你达成的每项指标，包括日后新增的。"
          }
        }
      }
    },
    "Free includes 3 custom streaks. Unlock Streaks+ for unlimited.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
