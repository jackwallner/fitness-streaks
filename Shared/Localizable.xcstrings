    "Per-workout-type streaks let you track yoga, runs, and lifts separately.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Streaks pro Workout-Art verfolgst du Yoga, Läufe und Krafttraining getrennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-workout-type streaks let you track yoga, runs, and lifts separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con rachas por tipo de entrenamiento, puedes seguir yoga, carreras y pesas por separado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met reeksen per workouttype volg je yoga, hardlopen en krachttraining apart."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серии по типам тренировок позволяют отдельно отслеживать йогу, бег и силовые."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi theo từng loại bài tập giúp bạn theo dõi riêng yoga, chạy bộ và cử tạ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按体能训练类型设置连续记录，瑜伽、跑步和举重可以分开追踪。"
          }
        }
      }
    },
