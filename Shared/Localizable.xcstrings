                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días"
                    }
                  }
                }
              }
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden je activiteiten van de afgelopen %#@n@ opnieuw geanalyseerd en kan een ander doel dan je huidige %2$@ worden voorgesteld. Als het nieuwe doel hoger is dan je recente activiteit, kan je reeks eindigen."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
