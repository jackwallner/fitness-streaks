                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto vuelve a analizar tu actividad de los últimos %#@n@ y puede sugerir un objetivo distinto del actual (%2$@). Si el nuevo objetivo es mayor que tu actividad reciente, tu racha podría romperse."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
