    },
    "Your purchase is syncing. Streak picks restore in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wird synchronisiert. Deine Streak-Auswahl ist gleich wieder da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is syncing. Streak picks restore in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se está sincronizando. Tus rachas elegidas se restaurarán en un momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop wordt gesynchroniseerd. Je gekozen reeksen komen zo terug."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка синхронизируется. Выбранные серии скоро вернутся."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch của bạn đang đồng bộ. Các chuỗi đã chọn sẽ được khôi phục ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买内容正在同步，连续记录的选择稍后恢复。"
          }
        }
      }
    },
    "Your run just ended. Start a Streaks+ trial and we'll restore it on the spot. Then auto-save every future miss so it can't happen again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Streak ist gerade gerissen. Starte die kostenlose Testphase von Streaks+ und wir stellen ihn sofort wieder her. Danach rettet Streaks+ jeden verpassten Tag automatisch, damit das nicht wieder passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your run just ended. Start a Streaks+ trial and we'll restore it on the spot. Then auto-save every future miss so it can't happen again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha acaba de terminar. Empieza una prueba de Streaks+ y la restauramos al instante. Después, protegeremos automáticamente cada día que falles para que no vuelva a pasar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reeks is net afgelopen. Start een proefperiode voor Streaks+ en we herstellen je reeks meteen. Daarna redden we je reeks automatisch als je een dag mist, zodat dit niet opnieuw gebeurt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя серия только что закончилась. Начни пробный период Streaks+, и мы сразу её вернём. Дальше каждый пропуск будет защищаться автоматически, и такого больше не повторится."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi của bạn vừa kết thúc. Bắt đầu dùng thử Streaks+ và chúng tôi sẽ khôi phục ngay lập tức. Sau đó tự động bảo vệ mọi lần bỏ lỡ về sau để chuyện này không lặp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的连续记录刚刚中断。开始试用 Streaks+，我们会立即帮你恢复，此后漏掉时也会自动保护连续记录。"
          }
        }
      }
    },
    "Your run just ended. Subscribe to Streaks+ and we'll restore it on the spot. Then auto-save every future miss so it can't happen again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Streak ist gerade gerissen. Abonniere Streaks+ und wir stellen ihn sofort wieder her. Danach rettet Streaks+ jeden verpassten Tag automatisch, damit das nicht wieder passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your run just ended. Subscribe to Streaks+ and we'll restore it on the spot. Then auto-save every future miss so it can't happen again."
