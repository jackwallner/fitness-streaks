    "Daily nudge at %@ if a tracked streak isn't locked in yet. iOS will ask for notification permission the first time you turn this on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Erinnerung um %@, falls ein verfolgter Streak noch nicht gesichert ist. iOS fragt beim ersten Aktivieren nach der Erlaubnis für Mitteilungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily nudge at %@ if a tracked streak isn't locked in yet. iOS will ask for notification permission the first time you turn this on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso diario a %@ si aún no has asegurado una racha que sigues. iOS te pedirá permiso para enviar notificaciones la primera vez que lo actives."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijkse herinnering om %@ als je een gevolgde reeks nog niet hebt gehaald. iOS vraagt om toestemming voor meldingen zodra je dit voor het eerst inschakelt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневное напоминание в %@, если сегодня отслеживаемая серия ещё не засчитана. При первом включении iOS запросит разрешение на уведомления."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc hằng ngày lúc %@ nếu một chuỗi đang theo dõi chưa hoàn thành. iOS sẽ hỏi quyền gửi thông báo ở lần đầu bạn bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果有追踪中的连续记录尚未达成，每天 %@ 提醒你一次。首次开启时，iOS 会请求通知权限。"
          }
        }
      }
    },
