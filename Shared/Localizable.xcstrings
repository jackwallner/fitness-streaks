    "Add ones you skipped at setup, build a custom streak for a specific workout, or surface streaks that just got long enough to count.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Streaks hinzu, die du beim Einrichten übersprungen hast, erstelle einen eigenen Streak für ein bestimmtes Workout oder finde Streaks, die inzwischen lang genug sind, um zu zählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add ones you skipped at setup, build a custom streak for a specific workout, or surface streaks that just got long enough to count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las que omitiste al configurar, crea una racha para un entrenamiento concreto o descubre rachas que ya son lo bastante largas para contar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg reeksen toe die je bij het instellen hebt overgeslagen, maak een eigen reeks voor een specifieke workout of laat reeksen zien die net lang genoeg zijn om mee te tellen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь серии, пропущенные при настройке, создай свою серию для конкретной тренировки или найди серии, которые стали достаточно длинными."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm những chuỗi bạn đã bỏ qua lúc thiết lập, tạo chuỗi tùy chỉnh cho một bài tập cụ thể, hoặc hiện những chuỗi vừa đủ dài để được tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加设置时跳过的项目，为特定体能训练自建连续记录，或找出刚好够长、值得计入的连续记录。"
          }
        }
      }
    },
    "Add the widget for a glanceable streak count on your home screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge das Widget hinzu, um deine Streak-Zahl direkt auf dem Home-Bildschirm zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the widget for a glanceable streak count on your home screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el widget para ver tu racha de un vistazo en la pantalla de inicio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de widget toe voor een reeksteller die je in één oogopslag ziet op je beginscherm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь виджет, чтобы видеть свою серию на экране «Домой»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tiện ích để xem nhanh độ dài chuỗi ngay trên Màn hình chính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加小组件，在主屏幕上一眼查看连续记录天数。"
          }
        }
      }
    },
    "Adjust the goal threshold for this streak.": {
