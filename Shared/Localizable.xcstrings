    "Change intensity, schedule planned freezes for travel or sick days, set a daily reminder, or replay this tour from About.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Intensität, plane Pausentage für Reisen oder Krankheitstage, stelle eine tägliche Erinnerung ein oder starte diese Tour unter „Info“ neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change intensity, schedule planned freezes for travel or sick days, set a daily reminder, or replay this tour from About."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la intensidad, programa días de pausa para viajes o días de enfermedad, fija un recordatorio diario o repite este recorrido desde Acerca de."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig de intensiteit, plan pauzedagen voor reizen of ziekte, stel een dagelijkse herinnering in of speel deze rondleiding opnieuw af via Info."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняй интенсивность, планируй дни заморозки для поездок и болезни, включи ежедневное напоминание или пройди обзор заново в разделе «О приложении»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi mức độ, lên lịch ngày đóng băng cho chuyến đi hoặc ngày ốm, đặt nhắc nhở hằng ngày, hoặc xem lại phần giới thiệu này trong Giới thiệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整强度，为出行或生病的日子安排冻结日，设置每日提醒，或在“关于”中重看这份导览。"
          }
        }
      }
    },
