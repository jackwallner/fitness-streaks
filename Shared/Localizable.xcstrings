      }
    },
    "Your run just ended. Start a Streaks+ trial and we'll restore it on the spot. Then auto-save every future miss so it can't happen again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Serie ist gerade gerissen. Starte eine Streaks+-Testphase und wir stellen sie sofort wieder her. Danach wird jeder weitere Fehltag automatisch gerettet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu racha acaba de terminar. Empieza una prueba de Streaks+ y la restauraremos al momento. Después, cada fallo futuro se rescata automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre série vient de se terminer. Lancez un essai Streaks+ et nous la restaurons sur-le-champ. Ensuite, chaque oubli sera sauvé automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua serie si è appena interrotta. Avvia una prova di Streaks+ e la ripristiniamo subito. Poi ogni giorno saltato verrà salvato in automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録が途切れたところです。Streaks+のトライアルを始めれば、すぐに復活させます。以降の逃した日も自動でセーブされます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reeks is net beëindigd. Start een Streaks+-proefperiode en we zetten hem meteen terug. Daarna wordt elke toekomstige misser automatisch gered."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja seria właśnie się przerwała. Zacznij okres próbny Streaks+, a od razu ją przywrócimy. Potem każdy kolejny opuszczony dzień uratujemy automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sequência acabou de terminar. Comece um teste do Streaks+ e a restauramos na hora. Depois, cada falha futura é resgatada automaticamente."
          }
        }
      }
    },
    "Your run just ended. Subscribe to Streaks+ and we'll restore it on the spot. Then auto-save every future miss so it can't happen again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Serie ist gerade gerissen. Abonniere Streaks+ und wir stellen sie sofort wieder her. Danach wird jeder weitere Fehltag automatisch gerettet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu racha acaba de terminar. Suscríbete a Streaks+ y la restauraremos al momento. Después, cada fallo futuro se rescata automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre série vient de se terminer. Abonnez-vous à Streaks+ et nous la restaurons sur-le-champ. Ensuite, chaque oubli sera sauvé automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua serie si è appena interrotta. Abbonati a Streaks+ e la ripristiniamo subito. Poi ogni giorno saltato verrà salvato in automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録が途切れたところです。Streaks+に登録すれば、すぐに復活させます。以降の逃した日も自動でセーブされます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reeks is net beëindigd. Neem Streaks+ en we zetten hem meteen terug. Daarna wordt elke toekomstige misser automatisch gered."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja seria właśnie się przerwała. Wykup Streaks+, a od razu ją przywrócimy. Potem każdy kolejny opuszczony dzień uratujemy automatycznie."
          }
