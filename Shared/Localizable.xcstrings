    "Add ones you skipped at setup, build a custom streak for a specific workout, or surface streaks that just got long enough to count." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge übersprungene Serien hinzu, erstelle eine eigene für ein bestimmtes Workout oder finde Serien, die gerade lang genug geworden sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade las que omitiste al empezar, crea una racha personalizada para un entrenamiento concreto o descubre rachas que ya son lo bastante largas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez celles ignorées au départ, créez une série pour un entraînement précis ou faites apparaître celles devenues assez longues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi quelle saltate all'inizio, crea una serie per un allenamento specifico o scopri le serie diventate abbastanza lunghe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初にスキップした記録を追加したり、特定のワークアウト用のカスタム記録を作ったり、条件を満たした新しい記録を表示したりできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg overgeslagen reeksen toe, maak een eigen reeks voor een specifieke workout of vind reeksen die net lang genoeg zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj serie pominięte na starcie, stwórz własną dla konkretnego treningu albo odkryj te, które właśnie stały się wystarczająco długie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as que você pulou no início, crie uma sequência personalizada para um treino específico ou descubra sequências que já ficaram longas o bastante."
          }
        }
      }
    },
    "Add the widget for a glanceable streak count on your home screen." : {
