    "Need a coach? Live one-on-one virtual personal training and nutrition coaching with Elsa.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach gesucht? Virtuelles Personal Training und Ernährungscoaching live im Einzeltraining mit Elsa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need a coach? Live one-on-one virtual personal training and nutrition coaching with Elsa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Necesitas un coach? Entrenamiento personal y coaching de nutrición virtuales, en vivo y 1 a 1 con Elsa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een coach nodig? Live virtuele personal training en voedingscoaching met Elsa, één op één."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен тренер? Онлайн-тренировки и консультации по питанию один на один с Эльзой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần huấn luyện viên? Huấn luyện cá nhân và tư vấn dinh dưỡng trực tuyến 1 kèm 1 trực tiếp cùng Elsa."
