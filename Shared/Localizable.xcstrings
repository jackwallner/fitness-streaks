        }
      }
    },
    "This re-derives every goal from your recent Apple Health activity. If new goals are higher than current ones, you may lose those streaks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei wird jedes Ziel aus deiner letzten Apple Health Aktivität neu berechnet. Liegen die neuen Ziele über den aktuellen, kannst du diese Streaks verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This re-derives every goal from your recent Apple Health activity. If new goals are higher than current ones, you may lose those streaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto recalcula cada objetivo a partir de tu actividad reciente en Apple Health. Si los nuevos objetivos son más altos que los actuales, podrías perder esas rachas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle doelen opnieuw bepaald op basis van je recente activiteit in Apple Health. Zijn de nieuwe doelen hoger dan de huidige, dan kun je die reeksen kwijtraken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все цели будут пересчитаны по твоей недавней активности в Apple Health. Если новые цели окажутся выше текущих, ты можешь потерять эти серии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này tính lại mọi mục tiêu từ hoạt động Apple Health gần đây của bạn. Nếu mục tiêu mới cao hơn mục tiêu hiện tại, bạn có thể mất các chuỗi đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会根据你近期的 Apple Health 活动重新推算每个目标。如果新目标高于当前目标，你可能会失去这些连续记录。"
          }
        }
      }
    },
