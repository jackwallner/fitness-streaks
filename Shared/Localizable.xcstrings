    },
    "How many days of history we use when suggesting new goals. Existing streaks stay locked at their committed value.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tage Verlauf wir für neue Zielvorschläge nutzen. Bestehende Streaks behalten ihren festgelegten Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days of history we use when suggesting new goals. Existing streaks stay locked at their committed value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos días de historial usamos al sugerir objetivos nuevos. Las rachas actuales conservan el objetivo que fijaste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel dagen geschiedenis we gebruiken om nieuwe doelen voor te stellen. Bestaande reeksen blijven vergrendeld op hun vastgelegde waarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько дней истории учитывать при подборе новых целей. У существующих серий цель остаётся зафиксированной."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số ngày lịch sử dùng để gợi ý mục tiêu mới. Các chuỗi hiện có vẫn giữ nguyên mức bạn đã cam kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐新目标时参考多少天的历史记录。现有的连续记录会保持在已设定的目标值。"
          }
        }
      }
    },
