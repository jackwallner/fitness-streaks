    "One missed day zeroes it out. Streaks+ auto-saves the run and tracks every streak you've earned, free for your %lld-day trial.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein verpasster Tag setzt deinen Streak auf null. Streaks+ rettet ihn automatisch und erfasst jeden Streak, den du dir verdient hast, kostenlos während deiner %#@n@."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg-tägigen Testphase"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg-tägigen Testphase"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One missed day zeroes it out. Streaks+ auto-saves the run and tracks every streak you've earned, free for your %#@n@."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
