    "Mark days you know you'll miss (vacation, travel, sick). Freeze days won't break your streaks or extend them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Tage, die du sicher verpasst (Urlaub, Reise, Krankheit). Pausentage brechen deine Serien nicht, verlängern sie aber auch nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca los días que sabes que fallarás (vacaciones, viajes, enfermedad). Los días de pausa no rompen tus rachas ni las alargan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez les jours que vous savez manquer (vacances, voyage, maladie). Les jours de pause ne cassent pas vos séries et ne les allongent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna i giorni che sai di saltare (vacanze, viaggi, malattia). I giorni di pausa non interrompono le serie e non le allungano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休むとわかっている日（休暇、旅行、体調不良）を登録しましょう。お休み日は記録を途切れさせず、延ばすこともありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer dagen die je zeker mist (vakantie, reis, ziekte). Pauzedagen breken je reeksen niet en verlengen ze ook niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznacz dni, które na pewno opuścisz (urlop, wyjazd, choroba). Dni przerwy nie przerywają serii ani ich nie wydłużają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque os dias que você sabe que vai perder (férias, viagem, doença). Dias de pausa não quebram suas sequências nem as aumentam."
          }
        }
      }
    },
