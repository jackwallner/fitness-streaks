    "Tap any locked streak to see Streaks+ plans and add it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine gesperrte Serie, um die Streaks+-Pläne zu sehen und sie hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una racha bloqueada para ver los planes de Streaks+ y añadirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une série verrouillée pour voir les offres Streaks+ et l'ajouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una serie bloccata per vedere i piani Streaks+ e aggiungerla."
